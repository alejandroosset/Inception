# Debian version
FROM debian:bookworm

# Check add ons, install MariaDB without them and deletes cache
RUN apt-get update &&\
    apt-get install -y --no-install-recommends mariadb-server &&\
    rm -rf /var/lib/apt/lists/*

# Copy MariaDB configuration to docker image
COPY conf/99-inception.cnf /etc/mysql/mariadb.conf.d/99-inception.cnf
COPY tools/init.sh /init.sh

# Give execution permits to init.sh
RUN chmod +x /init.sh

# Shows what port it is gonna be used
EXPOSE 3306

# Execute init.sh
CMD ["/init.sh"]